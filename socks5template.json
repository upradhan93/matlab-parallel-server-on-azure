{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "String"
    },
    "subnetId": {
      "type": "String"
    },
    "adminUsername": {
      "type": "String"
    },
    "adminPassword": {
      "type": "SecureString"
    },
    "createPublicIPAddress": {
      "type": "String",
      "defaultValue": "Yes",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Whether to attach a public IP address to the proxy VM."
      }
    },
    "clientIPAddressList": {
      "type": "String",
      "defaultValue": ""
    },
    "proxyDownloadUrl": {
      "type": "String",
      "defaultValue": "https://github.com/mathworks/parallel-server-proxy/releases/download/v1.0.0/parallelserverproxy-glnxa64.tar.gz",
      "metadata": {
        "description": "URL to download the parallelserverproxy tarball."
      }
    },
    "proxyVmName": {
      "type": "String",
      "defaultValue": "mjsproxy",
      "metadata": {
        "description": "Computer name for the proxy VM. Used for intra-VNet DNS resolution."
      }
    },
    "proxyVmSize": {
      "type": "String",
      "defaultValue": "Standard_B2s_v2",
      "metadata": {
        "description": "Azure VM size for the proxy VM."
      }
    },
    "proxyPort": {
      "type": "Int",
      "defaultValue": 1080,
      "metadata": {
        "description": "Port number for the SOCKS5 proxy server."
      }
    },
    "tags": {
      "type": "Object",
      "defaultValue": {}
    }
  },
  "variables": {
    "proxyNicName": "[concat(parameters('proxyVmName'), '-nic')]",
    "proxyIPName": "[concat(parameters('proxyVmName'), '-pip')]",
    "proxyNsgName": "[concat(parameters('proxyVmName'), '-nsg')]",
    "publicIpTimeout": "20",
    "enablePublicIP": "[equals(parameters('createPublicIPAddress'), 'Yes')]",
    "dnsLabelPrefix": "[concat(parameters('proxyVmName'), '-', uniqueString(resourceGroup().id))]",
    "clientIPs": "[replace(parameters('clientIPAddressList'), ' ', '')]",
    "clientIPsProvided": "[not(empty(variables('clientIPs')))]",
    "nicIpConfigWithPublicIp": [
      {
        "name": "[concat(parameters('proxyVmName'), '-ipconfig')]",
        "properties": {
          "subnet": {
            "id": "[parameters('subnetId')]"
          },
          "privateIPAllocationMethod": "Dynamic",
          "publicIpAddress": {
            "id": "[resourceId('Microsoft.Network/publicIpAddresses', variables('proxyIPName'))]"
          }
        }
      }
    ],
    "nicIpConfigWithoutPublicIp": [
      {
        "name": "[concat(parameters('proxyVmName'), '-ipconfig')]",
        "properties": {
          "subnet": {
            "id": "[parameters('subnetId')]"
          },
          "privateIPAllocationMethod": "Dynamic"
        }
      }
    ],
    "installDir": "/opt/mathworks/parallelserverproxy",
    "startupScript": [
      "#!/usr/bin/env bash",
      "set -euo pipefail",
      "exec > /var/log/proxy-startup.log 2>&1",
      "",
      "# Download and install parallelserverproxy",
      "[concat('INSTALL_DIR=\"', variables('installDir'), '\"')]",
      "mkdir -p \"$INSTALL_DIR\"",
      "[concat('wget -q \"', parameters('proxyDownloadUrl'), '\" -O /tmp/parallelserverproxy.tar.gz')]",
      "tar -xzf /tmp/parallelserverproxy.tar.gz -C \"$INSTALL_DIR\"",
      "chmod +x \"$INSTALL_DIR/parallelserverproxy\"",
      "rm -f /tmp/parallelserverproxy.tar.gz",
      "",
      "echo 'parallelserverproxy binary installed. Waiting for headnode to start the proxy.'"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2025-05-01",
      "name": "[variables('proxyNsgName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-proxy-inbound",
            "properties": {
              "priority": 1000,
              "sourceAddressPrefixes": "[if(variables('clientIPsProvided'), split(variables('clientIPs'), ','), json('[\"*\"]'))]",
              "protocol": "Tcp",
              "destinationPortRange": "[string(parameters('proxyPort'))]",
              "access": "Allow",
              "direction": "Inbound",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "allow-ssh-inbound",
            "properties": {
              "priority": 1010,
              "sourceAddressPrefixes": "[if(variables('clientIPsProvided'), split(variables('clientIPs'), ','), json('[\"*\"]'))]",
              "protocol": "Tcp",
              "destinationPortRange": "22",
              "access": "Allow",
              "direction": "Inbound",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-05-01",
      "condition": "[variables('enablePublicIP')]",
      "sku": {
        "name": "Standard"
      },
      "name": "[variables('proxyIPName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('dnsLabelPrefix')]"
        },
        "idleTimeoutInMinutes": "[variables('publicIpTimeout')]"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-05-01",
      "name": "[variables('proxyNicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIpAddresses', variables('proxyIPName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('proxyNsgName'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "ipConfigurations": "[if(variables('enablePublicIP'), variables('nicIpConfigWithPublicIp'), variables('nicIpConfigWithoutPublicIp'))]",
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('proxyNsgName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-04-01",
      "name": "[parameters('proxyVmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('proxyNicName'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('proxyVmSize')]"
        },
        "osProfile": {
          "computerName": "[parameters('proxyVmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('proxyNicName'))]"
            }
          ]
        }
      },
      "resources": [
        {
          "type": "extensions",
          "apiVersion": "2025-04-01",
          "name": "startup",
          "location": "[parameters('location')]",
          "dependsOn": [
            "[resourceId('Microsoft.Compute/virtualMachines', parameters('proxyVmName'))]"
          ],
          "tags": {
            "displayName": "startup"
          },
          "properties": {
            "publisher": "Microsoft.Azure.Extensions",
            "type": "CustomScript",
            "typeHandlerVersion": "2.1",
            "autoUpgradeMinorVersion": true,
            "settings": {
              "skipDos2Unix": false
            },
            "protectedSettings": {
              "script": "[base64(join(variables('startupScript'), '\n'))]"
            }
          }
        }
      ]
    }
  ],
  "outputs": {
    "proxyFQDN": {
      "type": "String",
      "condition": "[variables('enablePublicIP')]",
      "value": "[reference(variables('proxyIPName')).dnsSettings.fqdn]"
    },
    "proxyPrivateIP": {
      "type": "String",
      "value": "[reference(variables('proxyNicName')).ipConfigurations[0].properties.privateIPAddress]"
    }
  }
}
