{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string"
    },
    "namingPrefix": {
      "type": "string"
    },
    "resourceGroupUniqueString": {
      "type": "string"
    },
    "subnetId": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "proxyPort": {
      "type": "string"
    },
    "mjsPortRange": {
      "type": "string",
      "metadata": {
        "description": "Port range (e.g. 27350-27365) that the MATLAB Job Scheduler uses for cluster communication, passed in by the parent template (matches the mathworks-job-scheduler-inbound rule). The proxy is only permitted to forward traffic to these ports within the virtual network."
      }
    },
    "proxyInstanceSize": {
      "type": "string",
      "defaultValue": "Standard_B2als_v2",
      "metadata": {
        "description": "Azure virtual machine size to use for the SOCKS5 proxy VM. The proxy only forwards traffic, so a small burstable VM is sufficient."
      }
    },
    "certSasUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "(Optional) Pre-generated short-lived SAS URL for the MJS certificate file on the cluster file share. If left empty, the template generates one from the storage account using listServiceSas."
      }
    },
    "clientIPs": {
      "type": "string"
    },
    "proxyDNSLabel": {
      "type": "string"
    },
    "tagsForAll": {
      "type": "object"
    },
    "_currentTime": {
      "type": "string",
      "defaultValue": "[utcNow()]"
    }
  },
  "variables": {
    "proxyVmName": "[concat('mjsproxy-', parameters('resourceGroupUniqueString'))]",
    "proxyVmSize": "[parameters('proxyInstanceSize')]",
    "proxyPublicIPName": "[concat(parameters('namingPrefix'), '-proxy-pub')]",
    "proxyNicName": "[concat(parameters('namingPrefix'), '-proxy-nic')]",
    "proxyNsgName": "[concat(parameters('namingPrefix'), '-proxy-nsg')]",
    "publicIpTimeout": "20",
    "fileShareName": "shared",
    "certFilePath": "cluster/cert",
    "proxyBinaryFilePath": "cluster/parallelserverproxy-glnxa64.tar.gz",
    "certFileBaseUrl": "[concat('https://', parameters('storageAccountName'), '.file.core.windows.net/', variables('fileShareName'), '/', variables('certFilePath'))]",
    "proxyBinaryFileBaseUrl": "[concat('https://', parameters('storageAccountName'), '.file.core.windows.net/', variables('fileShareName'), '/', variables('proxyBinaryFilePath'))]",
    "sasExpiry": "[dateTimeAdd(parameters('_currentTime'), 'PT30M')]",
    "certSasParameters": {
      "canonicalizedResource": "[concat('/file/', parameters('storageAccountName'), '/', variables('fileShareName'), '/', variables('certFilePath'))]",
      "signedResource": "f",
      "signedProtocol": "https",
      "signedPermission": "r",
      "signedExpiry": "[variables('sasExpiry')]"
    },
    "proxyBinarySasParameters": {
      "canonicalizedResource": "[concat('/file/', parameters('storageAccountName'), '/', variables('fileShareName'), '/', variables('proxyBinaryFilePath'))]",
      "signedResource": "f",
      "signedProtocol": "https",
      "signedPermission": "r",
      "signedExpiry": "[variables('sasExpiry')]"
    },
    "proxyAllowClientIPSecurityRules": [
      {
        "name": "allow-socks5-inbound",
        "properties": {
          "priority": 1000,
          "sourceAddressPrefixes": "[split(parameters('clientIPs'), ',')]",
          "protocol": "Tcp",
          "destinationPortRange": "[parameters('proxyPort')]",
          "access": "Allow",
          "direction": "Inbound",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*"
        }
      },
      {
        "name": "allow-ssh-inbound",
        "properties": {
          "priority": 1010,
          "sourceAddressPrefixes": "[split(parameters('clientIPs'), ',')]",
          "protocol": "Tcp",
          "destinationPortRange": "22",
          "access": "Allow",
          "direction": "Inbound",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*"
        }
      }
    ],
    "proxyInboundSecurityRules": "[if(not(empty(parameters('clientIPs'))), variables('proxyAllowClientIPSecurityRules'), createArray())]",
    "proxyOutboundSecurityRules": [
      {
        "name": "allow-storage-outbound",
        "properties": {
          "priority": 200,
          "sourceAddressPrefix": "*",
          "protocol": "Tcp",
          "destinationPortRange": "443",
          "access": "Allow",
          "direction": "Outbound",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "[concat('Storage.', replace(toLower(parameters('location')), ' ', ''))]"
        }
      },
      {
        "name": "allow-mjs-outbound",
        "properties": {
          "priority": 210,
          "sourceAddressPrefix": "*",
          "protocol": "Tcp",
          "destinationPortRange": "[parameters('mjsPortRange')]",
          "access": "Allow",
          "direction": "Outbound",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "VirtualNetwork"
        }
      },
      {
        "name": "deny-all-outbound",
        "properties": {
          "priority": 4096,
          "sourceAddressPrefix": "*",
          "protocol": "*",
          "destinationPortRange": "*",
          "access": "Deny",
          "direction": "Outbound",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*"
        }
      }
    ],
    "proxyNsgRules": "[concat(variables('proxyInboundSecurityRules'), variables('proxyOutboundSecurityRules'))]",
    "proxyStartupScript": [
      "#!/usr/bin/env bash",
      "# Copyright 2026 The MathWorks, Inc.",
      "",
      "# Redirect all output to a log file",
      "mkdir -p /var/log/mathworks",
      "exec > >(tee -a /var/log/mathworks/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1",
      "set -euo pipefail",
      "",
      "[concat('PROXY_PORT=\"', parameters('proxyPort'), '\"')]",
      "CERT_SAS_URL=\"__CERT_SAS_URL__\"",
      "PROXY_BINARY_SAS_URL=\"__PROXY_BINARY_SAS_URL__\"",
      "CERT_FILE=\"/opt/mjs/cert\"",
      "PROXY_DIR=\"/opt/parallelserverproxy\"",
      "LOG_FILE=\"/var/log/parallelserverproxy.log\"",
      "PROXY_USER=\"mjsproxy\"",
      "",
      "id \"$PROXY_USER\" >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin \"$PROXY_USER\"",
      "",
      "mkdir -p /opt/mjs \"$PROXY_DIR\"",
      "",
      "# Download proxy binary from cluster file share via short-lived SAS URL",
      "# (binary is baked into the headnode image and staged on the file share",
      "# by Setup-MJS.ps1).",
      "curl -fsSL -H 'x-ms-version: 2024-11-04' \"$PROXY_BINARY_SAS_URL\" | tar -xz -C \"$PROXY_DIR\"",
      "PROXY_BIN=$(find \"$PROXY_DIR\" -type f -name 'parallelserverproxy*' | head -1)",
      "",
      "# Download cert via short-lived SAS URL",
      "curl -fsSL -H 'x-ms-version: 2024-11-04' \"$CERT_SAS_URL\" -o \"$CERT_FILE\"",
      "",
      "chown \"$PROXY_USER:$PROXY_USER\" \"$CERT_FILE\"",
      "chmod 400 \"$CERT_FILE\"",
      "chown \"root:$PROXY_USER\" \"$PROXY_BIN\"",
      "chmod 550 \"$PROXY_BIN\"",
      "",
      "touch \"$LOG_FILE\"",
      "chown \"$PROXY_USER:$PROXY_USER\" \"$LOG_FILE\"",
      "chmod 640 \"$LOG_FILE\"",
      "",
      "cat > /etc/systemd/system/parallelserverproxy.service <<EOF",
      "[[Unit]",
      "Description=MATLAB Parallel Server SOCKS5 Proxy",
      "After=network.target",
      "",
      "[[Service]",
      "User=$PROXY_USER",
      "Group=$PROXY_USER",
      "ExecStart=$PROXY_BIN -certificate $CERT_FILE -port $PROXY_PORT",
      "Restart=always",
      "RestartSec=5",
      "StandardOutput=append:$LOG_FILE",
      "StandardError=append:$LOG_FILE",
      "NoNewPrivileges=yes",
      "ProtectSystem=full",
      "ProtectHome=yes",
      "PrivateTmp=yes",
      "ProtectKernelTunables=yes",
      "ProtectControlGroups=yes",
      "# Block the proxy process from reaching Azure IMDS. IMDS is link-local",
      "# and exempt from NSG rules, so a SOCKS5 client could otherwise ask the",
      "# proxy to fetch instance metadata or managed-identity tokens.",
      "IPAddressDeny=169.254.169.254/32",
      "",
      "[[Install]",
      "WantedBy=multi-user.target",
      "EOF",
      "",
      "systemctl daemon-reload",
      "systemctl enable --now parallelserverproxy.service"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-05-01",
      "name": "[variables('proxyPublicIPName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tagsForAll')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[parameters('proxyDNSLabel')]"
        },
        "idleTimeoutInMinutes": "[variables('publicIpTimeout')]"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2025-05-01",
      "name": "[variables('proxyNsgName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tagsForAll')]",
      "properties": {
        "securityRules": "[variables('proxyNsgRules')]"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-05-01",
      "name": "[variables('proxyNicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('proxyPublicIPName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('proxyNsgName'))]"
      ],
      "tags": "[parameters('tagsForAll')]",
      "properties": {
        "enableAcceleratedNetworking": true,
        "ipConfigurations": [
          {
            "name": "[concat(variables('proxyVmName'), '-ipconfig')]",
            "properties": {
              "subnet": {
                "id": "[parameters('subnetId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIpAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('proxyPublicIPName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('proxyNsgName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-04-01",
      "name": "[variables('proxyVmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('proxyNicName'))]"
      ],
      "tags": "[parameters('tagsForAll')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('proxyVmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('proxyVmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false,
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('proxyNicName'))]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2025-04-01",
      "name": "[concat(variables('proxyVmName'), '/proxyStartup')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('proxyVmName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "skipDos2Unix": false
        },
        "protectedSettings": {
          "script": "[base64(replace(replace(join(variables('proxyStartupScript'), '\n'), '__CERT_SAS_URL__', if(empty(parameters('certSasUrl')), concat(variables('certFileBaseUrl'), '?', listServiceSas(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2024-01-01', variables('certSasParameters')).serviceSasToken), parameters('certSasUrl'))), '__PROXY_BINARY_SAS_URL__', concat(variables('proxyBinaryFileBaseUrl'), '?', listServiceSas(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2024-01-01', variables('proxyBinarySasParameters')).serviceSasToken)))]"
        }
      }
    }
  ],
  "outputs": {
    "proxyFQDN": {
      "type": "string",
      "value": "[concat(parameters('proxyDNSLabel'), '.', resourceGroup().location, '.cloudapp.azure.com')]"
    }
  }
}
